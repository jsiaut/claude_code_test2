+// v4, point 3 (docs/V4_EQUAL.md, R3) : variante tuned. PHP n'a pas de SIMD : la meilleure forme trouvée dans la
+// bibliothèque standard laisse la boucle au C : count_chars compte chaque valeur d'octet de la chaîne lue telle quelle,
+// puis la somme des valeurs >= 128 pondérées par leurs comptes (256 tours au plus).
+function k4_tuned(string $s): int
+{
+    $t = 0;
+    foreach (count_chars($s, 1) as $b => $n) {
+        if ($b >= 128) {
+            $t += $b * $n;
+        }
+    }
+    return $t;
+}
