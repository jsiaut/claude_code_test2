+# v4, point 3 (docs/V4_EQUAL.md, R3) : variante tuned, SIMD explicite (SIMD[DType.uint8, 64]) : la forme de la
+# remarque sur Mojo (bench/mojo_exp, k4_simd) : 64 octets par tour, masque >= 128, accumulateurs 32 bits (au plus
+# 255 x 2^18 par voie : pas de débordement).
+@inline(.never)
+def k4_tuned(v: List[UInt8]) -> UInt64:
+    comptime W = 64
+    var p = v.unsafe_ptr()
+    var n = len(v)
+    var acc = SIMD[DType.uint32, W](0)
+    var i = 0
+    while i + W <= n:
+        var x = p.unsafe_load[width=W](i)
+        acc += x.ge(SIMD[DType.uint8, W](128)).select(x, SIMD[DType.uint8, W](0)).cast[DType.uint32]()
+        i += W
+    var s = acc.cast[DType.uint64]().reduce_add()
+    while i < n:
+        var b = p[unsafe_offset=i]
+        if b >= 128:
+            s += UInt64(b)
+        i += 1
+    return s
+
