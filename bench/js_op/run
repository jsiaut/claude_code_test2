#!/bin/sh
# v4, point 6 (docs/V4_OPEN.md, 5.2) : la commande publiée, les modules de la piste ouverte en plus (NODE_PATH :
# /opt/open/js/node_modules ; package-lock.json dans results/open/lock/js).
