#!/bin/sh
# Remarque sur C# (docs/CSHARP.md) : binaire de la campagne (bench/csharp), optimisation complète dès le premier appel
# (compilation à niveaux désactivée : ni code de niveau 0, ni OSR, ni PGO dynamique). Sensibilité du protocole.
export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_TieredCompilation=0
exec /opt/dotnet/dotnet "$(dirname "$0")/../csharp/bin/rel/ms.dll" "$@"
