#!/bin/sh
# Remarque sur PHP (docs/PHP.md, 5), information : le banc publié (bench/php/ms.php) exécuté par PHP 8.6.0RC5 (/opt/php86rc5,
# tools/php_remark/build.sh : mêmes options de construction que 8.5.12), avec les options de bench/php/run.
exec /opt/php86rc5/bin/php  -d memory_limit=-1 -d opcache.enable_cli=1 -d opcache.jit=tracing \
  -d opcache.file_update_protection=0 "$(dirname "$0")/../php/ms.php" "$@"
